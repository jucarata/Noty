# Copy this file to .env and fill in the values.
# Dashboard: Connect, or Settings → API Keys (publishable key only).
# Never put the secret / service_role key here.
#
# Flutter inyecta estas variables en compile-time:
#   flutter run --dart-define-from-file=.env
# Desde Cursor: F5 (config noty) o .\scripts\run.ps1

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
